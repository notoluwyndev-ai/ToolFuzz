{
  "id": "gobuster",
  "name": "Gobuster",
  "icon": "📂",
  "category": "webfuzz",
  "description": "Descubrimiento de rutas web en un servidor privado autorizado.",
  "binary": "gobuster",
  "commands": [
    {
      "id": "gobuster_dir",
      "label": "Descubrimiento de directorios web",
      "runtime_seconds": 300,
      "args": ["dir", "-u", "{target}", "-w", "{wordlist}", "--threads", "10", "--timeout", "10s"],
      "fields": [
        {
          "id": "target",
          "label": "URL privada objetivo",
          "type": "text",
          "placeholder": "https://192.168.1.10:8443/app/",
          "required": true,
          "validation": "private_url"
        },
        {
          "id": "wordlist",
          "label": "Ruta de wordlist",
          "type": "text",
          "required": true,
          "validation": "local_file"
        }
      ]
    }
  ]
}
