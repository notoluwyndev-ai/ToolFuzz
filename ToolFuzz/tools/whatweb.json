{
  "id": "whatweb",
  "name": "WhatWeb",
  "icon": "🌐",
  "category": "webfuzz",
  "description": "Identifica tecnologías web en una URL privada autorizada.",
  "binary": "whatweb",
  "commands": [
    {
      "id": "whatweb_private",
      "label": "Identificación de tecnologías web",
      "runtime_seconds": 60,
      "args": ["--no-errors", "--aggression", "1", "--open-timeout=5", "--read-timeout=10", "{url}"],
      "fields": [
        {
          "id": "url",
          "label": "URL de la web privada",
          "type": "text",
          "placeholder": "http://192.168.1.10",
          "required": true,
          "validation": "private_url"
        }
      ]
    }
  ]
}
